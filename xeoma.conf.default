# Password: put only the password in xeoma_password, without quotes or escaping. Trailing newlines are ignored. Mount
# your config directory at /config to include this file, or mount a separate host password file read-only at
# /config/xeoma_password (both mounts can coexist). Create the host password file before mounting it.

# The version to use. Valid values are a string like '25.8.22', 'latest', 'latest_beta', or a URL.
VERSION='latest'

# To configure the mac address to a specific value. (Prevents a new one from being generated during container recreation.)
MAC_ADDRESS=

# Older PASSWORD in the config file are still supported, but not recommended.
